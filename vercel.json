{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "composer install --no-dev --prefer-dist --optimize-autoloader && npm ci && npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "rewrites": [
        {
            "source": "/build/(.*)",
            "destination": "/build/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/api/index.php"
        }
    ]
}
